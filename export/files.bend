# Everything export writes or asks, decided here and only carried out by the shell
# (export/web.ts): where the folders are, the text of each generated file, how a built file is
# classified and measured, the headers it is served with, and the verdict and manifest of a
# build. The shell gives plain values (strings, numbers, booleans) and never builds or reads a
# Bend type itself.
#
#   out_dir()                 the engine's build folder, .export (one def: the name may change)
#   game_module(slug)         .export/gen/<slug>/game.bend: the game's Bend, re-exported for runGame
#   entry_js(slug)            .export/gen/<slug>/entry.js: imports the game, its skins, its shaders
#   index_html / credits_html the two pages (export/pages.bend)
#   entry(path, bytes, gz, sha, rest)  one measured file onto the list release() reads
#   release(...)              the verdict (export/contract.bend) on a measured build
#   json(outcome, id)         game.json, written last
#
# Limits now:
# - A game is one of PROJECT.bend's projects, named by its folder (water, character, mannequin,
#   animation). A creator's own repository with its own game file comes with the publish service.
# - The generated module imports PROJECT.bend, so every project's code ships in every game
#   (about 28 KB gzip today). A game file per project removes that.
# - JSON is written by hand here: strings are escaped for quotes, backslashes and newlines only.

import Base
import ../PROJECT.bend as P
import ./contract.bend as Ex
import ./needs.bend as N
import ./pages.bend as Pg

def out_dir() -> String: ".export"

def Files.under(+a: String, +b: String) -> String:
  String.concat([out_dir(), "/", a, "/", b])

def folder(+slug: String) -> String: Files.under("web", slug)

def site_dir(+slug: String) -> String: String.append(folder(slug), "/site")

def gen_dir(+slug: String) -> String: Files.under("gen", slug)

# A slug names a project when PROJECT.bend's own lookup gives that project back (an unknown
# slug falls back to the opening project there, whose folder is another name).
def known(+slug: String) -> Bool:
  String.eq(P.folder(P.preview(slug)), slug)

def title(+slug: String) -> String: P.name(P.preview(slug))

def shader_folder(+slug: String) -> String: P.folder(P.preview(slug))

def Files.skins(+slug: String) -> List<&2, String>: N.skins(P.start(P.preview(slug)))

def shader_ids(+slug: String) -> List<&2, String>: N.shaders(P.start(P.preview(slug)))

def Files.any_hlsl(ids: List<&2, String>) -> Bool:
  match ids:
    case Nil{}:
      False{}
    case Con{+id, t}:
      (String.ends_with(id, ".hlsl") || Files.any_hlsl(t))

def hlsl(+slug: String) -> Bool: Files.any_hlsl(shader_ids(slug))

# ---------- Generated sources ----------

# From .export/gen/<slug>/ back to the repository root.
def Files.root() -> String: "../../../"

def game_module(+slug: String) -> String:
  String.concat([
    "# Generated by export for the game \"", slug, "\" (export/files.bend). Do not edit: export\n",
    "# writes it again on every build. platform/web/run.js reads these defs.\n\n",
    "import Base\n",
    "import ", Files.root(), "PROJECT.bend as P\n",
    "import ", Files.root(), "engine/scene.bend as S\n",
    "import ", Files.root(), "engine/camera.bend as Cam\n",
    "import ", Files.root(), "engine/locomotion.bend as Lo\n",
    "import ", Files.root(), "KEYS.bend as K\n",
    "import ", Files.root(), "node_modules/bend-ui/SPEC.bend as Spec\n",
    "import ", Files.root(), "editor/defaults/ACCESSIBILITY.bend as A\n\n",
    "def start() -> S.Scene: P.start(P.preview(\"", slug, "\"))\n\n",
    "def camera() -> Cam.Cam: P.camera(P.preview(\"", slug, "\"))\n\n",
    "def reduce_motion(+system: Bool) -> Bool: (A.reduce_motion() || system)\n\n",
    "def runs(+s: S.Scene, +reduce: Bool) -> Bool: Lo.runs(s, reduce)\n\n",
    "def frame(+s: S.Scene, +i: Lo.Input, +dt: F32, +reduce: Bool) -> S.Scene: Lo.frame(s, i, dt, reduce)\n\n",
    "def drive(s: S.Scene, +i: Lo.Input, +dt: F32, +stepping: Bool) -> S.Scene: Lo.drive(s, i, dt, stepping)\n\n",
    "def input(+forward: U32, +turn: U32) -> Lo.Input: Lo.input(forward, turn)\n\n",
    "def keymap() -> List<&2, Spec.Shortcut>: K.keymap()\n\n",
    "def is_walk(+action: String) -> Bool: K.is_walk(action)\n\n",
    "def walk_forward(+action: String) -> U32: K.walk_forward(action)\n\n",
    "def walk_turn(+action: String) -> U32: K.walk_turn(action)\n"])

def Files.textures(ts: List<&2, String>, +i: U32, +n: String) -> String:
  match ts:
    case Nil{}:
      ""
    case Con{t, rest}:
      String.concat(["import ", n, "_t", U32.show(i), " from \"", Files.root(), t, "\";\n",
        Files.textures(rest, (i + 1 : U32), n)])

def Files.texture_names(ts: List<&2, String>, +i: U32, +n: String) -> String:
  match ts:
    case Nil{}:
      ""
    case Con{_, rest}:
      String.concat([n, "_t", U32.show(i), ", ", Files.texture_names(rest, (i + 1 : U32), n)])

def Files.skin_imports(ss: List<&2, N.Skin>, +i: U32) -> String:
  match ss:
    case Nil{}:
      ""
    case Con{N.Skin{_, info, bin, +ts}, rest}:
      String.concat([
        "import skin", U32.show(i), "_info from \"", Files.root(), info, "\";\n",
        "import skin", U32.show(i), "_bin from \"", Files.root(), bin, "\" with { type: \"file\" };\n",
        Files.textures(ts, 0, String.append("skin", U32.show(i))),
        Files.skin_imports(rest, (i + 1 : U32))])

def Files.skin_table(ss: List<&2, N.Skin>, +i: U32) -> String:
  match ss:
    case Nil{}:
      ""
    case Con{N.Skin{name, _, _, +ts}, rest}:
      String.concat([
        "\"", name, "\": { info: skin", U32.show(i), "_info, bin: skin", U32.show(i), "_bin, textures: [",
        Files.texture_names(ts, 0, String.append("skin", U32.show(i))), "] }, ",
        Files.skin_table(rest, (i + 1 : U32))])

def Files.entry_of(+slug: String, +ss: List<&2, N.Skin>) -> String:
  String.concat([
    "// Generated by export for the game \"", slug, "\" (export/files.bend). Do not edit.\n",
    "import Game from \"./game.bend\";\n",
    "import { runGame } from \"", Files.root(), "platform/web/run.js\";\n",
    "import shaders from \"./shaders.json\";\n",
    Files.skin_imports(ss, 0),
    "runGame(document.getElementById(\"game\"), Game, { skins: { ",
    Files.skin_table(ss, 0), "}, shaders });\n"])

def entry_js(+slug: String) -> String:
  Files.entry_of(slug, N.Skins.files(Files.skins(slug)))

def index_html(+slug: String) -> String:
  Pg.text(Pg.game(title(slug), "./entry.js"))

def credits_html(+slug: String) -> String:
  Pg.text(Pg.credits(title(slug), Ex.credits(N.works(Files.skins(slug)))))

# ---------- Measuring a built file ----------

def Files.ends(+path: String, +ext: String) -> Bool: String.ends_with(path, ext)

def Files.role.code(code: Bool) -> Ex.Role:
  match code:
    case True{}:
      Ex.Role.Code{}
    case False{}:
      Ex.Role.Asset{}

def Files.role.doc(doc: Bool, code: Bool) -> Ex.Role:
  match doc:
    case True{}:
      Ex.Role.Doc{}
    case False{}:
      Files.role.code(code)

def Files.role.page(page: Bool, doc: Bool, code: Bool) -> Ex.Role:
  match page:
    case True{}:
      Ex.Role.Page{}
    case False{}:
      Files.role.doc(doc, code)

def role_of(+path: String) -> Ex.Role:
  Files.role.page(String.eq(path, "index.html"), String.eq(path, "credits.html"),
    (Files.ends(path, ".js") || Files.ends(path, ".mjs") || Files.ends(path, ".css")))

# Files already compressed travel as they are; everything else travels gzipped.
def compresses(+path: String) -> Bool:
  Bool.not((Files.ends(path, ".png") || Files.ends(path, ".jpg") || Files.ends(path, ".jpeg")
    || Files.ends(path, ".webp") || Files.ends(path, ".ktx2") || Files.ends(path, ".woff2")))

def Files.wire(keep: Bool, +bytes: U32, +gz: U32) -> U32:
  match keep:
    case True{}:
      gz
    case False{}:
      bytes

def entries_none() -> List<&2, Ex.Entry>: []

def entry(+path: String, +bytes: U32, +gz: U32, +sha: String, +rest: List<&2, Ex.Entry>) -> List<&2, Ex.Entry>:
  Ex.Entry{path, role_of(path), bytes, Files.wire(compresses(path), bytes, gz), sha} <> rest

def tools(+bend: String, +treeshake: Bool, +dxc: Bool, +spirv_cross: Bool) -> Ex.Toolchain:
  Ex.Toolchain{bend, treeshake, dxc, spirv_cross}

def release(checks: Bool, +slug: String, +es: List<&2, Ex.Entry>, +credits_page: Bool, +t: Ex.Toolchain) -> Ex.Outcome:
  Ex.release(checks, Ex.Facts{slug, title(slug), es, N.works(Files.skins(slug)), credits_page, hlsl(slug), t})

def shipped(o: Ex.Outcome) -> Bool:
  match o:
    case Ex.Outcome.Shipped{_}:
      True{}
    case Ex.Outcome.Refused{_}:
      False{}

def Files.say(rs: List<&2, Ex.Reason>) -> String:
  match rs:
    case Nil{}:
      ""
    case Con{r, t}:
      String.concat(["refused: ", Ex.say(r), "\n", Files.say(t)])

def reasons_text(o: Ex.Outcome) -> String:
  match o:
    case Ex.Outcome.Shipped{_}:
      ""
    case Ex.Outcome.Refused{rs}:
      Files.say(rs)

# ---------- Serving ----------

def Files.cache_control(c: Ex.Cache) -> String:
  match c:
    case Ex.Cache.Immutable{}:
      "public, max-age=31536000, immutable"
    case Ex.Cache.Revalidate{}:
      "no-cache"

def cache_control(+path: String) -> String: Files.cache_control(Ex.cache(role_of(path)))

def Files.type_pick(c: Bool, a: String, b: String) -> String:
  match c:
    case True{}:
      a
    case False{}:
      b

def content_type(+path: String) -> String:
  Files.type_pick(Files.ends(path, ".html"), "text/html; charset=utf-8",
  Files.type_pick((Files.ends(path, ".js") || Files.ends(path, ".mjs")), "text/javascript; charset=utf-8",
  Files.type_pick(Files.ends(path, ".css"), "text/css; charset=utf-8",
  Files.type_pick(Files.ends(path, ".json"), "application/json",
  Files.type_pick(Files.ends(path, ".png"), "image/png",
  Files.type_pick((Files.ends(path, ".jpg") || Files.ends(path, ".jpeg")), "image/jpeg",
  "application/octet-stream"))))))

# ---------- The manifest ----------

def Files.json_char(+code: U32) -> String:
  Files.type_pick(U32.is_eq(code, 34), "\\\"",
  Files.type_pick(U32.is_eq(code, 92), "\\\\",
  Files.type_pick(U32.is_eq(code, 10), "\\n", SCon{Chr{code}, SNil{}})))

def Files.json_body(s: String) -> String:
  match s:
    case SNil{}:
      ""
    case SCon{Chr{code}, t}:
      String.append(Files.json_char(code), Files.json_body(t))

def Files.str(+s: String) -> String: String.concat(["\"", Files.json_body(s), "\""])

def Files.role_name(r: Ex.Role) -> String:
  match r:
    case Ex.Role.Page{}:
      "page"
    case Ex.Role.Doc{}:
      "doc"
    case Ex.Role.Code{}:
      "code"
    case Ex.Role.Asset{}:
      "asset"

def Files.entries_json(es: List<&2, Ex.Entry>, first: Bool) -> String:
  match es:
    case Nil{}:
      ""
    case Con{Ex.Entry{path, role, bytes, wire, sha}, t}:
      String.concat([Files.type_pick(first, "\n    ", ",\n    "),
        "{\"path\": ", Files.str(path), ", \"role\": ", Files.str(Files.role_name(role)),
        ", \"bytes\": ", U32.show(bytes), ", \"wire\": ", U32.show(wire), ", \"sha256\": ", Files.str(sha), "}",
        Files.entries_json(t, False{})])

def Files.credits_json(cs: List<&2, Ex.Credit>, first: Bool) -> String:
  match cs:
    case Nil{}:
      ""
    case Con{Ex.Credit{title, author, license, url, notice}, t}:
      String.concat([Files.type_pick(first, "\n    ", ",\n    "),
        "{\"title\": ", Files.str(title), ", \"author\": ", Files.str(author), ", \"license\": ", Files.str(license),
        ", \"url\": ", Files.str(url), ", \"notice\": ", Files.str(notice), "}",
        Files.credits_json(t, False{})])

def Files.manifest_json(m: Ex.Manifest, +id: String) -> String:
  match m:
    case Ex.Manifest{format, game, title, Ex.Load{code, assets}, credits, entries}:
      String.concat(["{\n  \"format\": ", U32.show(format),
        ",\n  \"build\": ", Files.str(id),
        ",\n  \"game\": ", Files.str(game),
        ",\n  \"title\": ", Files.str(title),
        ",\n  \"load\": {\"code\": ", U32.show(code), ", \"assets\": ", U32.show(assets), "}",
        ",\n  \"credits\": [", Files.credits_json(credits, True{}), "\n  ]",
        ",\n  \"entries\": [", Files.entries_json(entries, True{}), "\n  ]\n}\n"])

def json(o: Ex.Outcome, +id: String) -> String:
  match o:
    case Ex.Outcome.Shipped{m}:
      Files.manifest_json(m, id)
    case Ex.Outcome.Refused{_}:
      ""

# The text the build id is the sha256 of: every served file's hash and path, then the format and
# the game. The same files give the same id, so building twice changes nothing anywhere.
def Files.id_lines(es: List<&2, Ex.Entry>) -> String:
  match es:
    case Nil{}:
      ""
    case Con{Ex.Entry{path, _, _, _, sha}, t}:
      String.concat([sha, " ", path, "\n", Files.id_lines(t)])

def id_text(o: Ex.Outcome) -> String:
  match o:
    case Ex.Outcome.Shipped{Ex.Manifest{format, game, _, _, _, entries}}:
      String.concat([Files.id_lines(entries), "format ", U32.show(format), "\ngame ", game, "\n"])
    case Ex.Outcome.Refused{_}:
      ""
