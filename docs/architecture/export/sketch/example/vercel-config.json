{
  "version": 3,
  "routes": [
    { "src": "^/_/(.*)$", "headers": { "cache-control": "public, max-age=31536000, immutable", "x-content-type-options": "nosniff" }, "continue": true },
    { "src": "^/a/(.*)$", "headers": { "cache-control": "public, max-age=31536000, immutable", "x-content-type-options": "nosniff" }, "continue": true },
    { "src": "^/(index\\.html)?$", "headers": { "cache-control": "public, max-age=0, must-revalidate", "x-content-type-options": "nosniff" }, "continue": true },
    { "handle": "filesystem" }
  ]
}
